<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.NumberBookApp" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/nb_teal_primary</item>
        <item name="colorPrimaryDark">@color/nb_teal_dark</item>
        <item name="colorAccent">@color/nb_coral_accent</item>
        <item name="android:colorBackground">@color/nb_background</item>
        <item name="colorSurface">@color/nb_surface</item>
        <item name="android:textColorPrimary">@color/nb_text_primary</item>
        <item name="android:statusBarColor">@color/nb_teal_dark</item>
    </style>

    <style name="Theme.NumberBookApp" parent="Base.Theme.NumberBookApp" />

    <style name="Widget.NumberBookApp.PrimaryButton" parent="Widget.Material3.Button">
        <item name="android:textColor">@color/nb_text_on_primary</item>
        <item name="backgroundTint">@color/nb_teal_primary</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">52dp</item>
    </style>

    <style name="Widget.NumberBookApp.AccentButton" parent="Widget.Material3.Button">
        <item name="android:textColor">@color/nb_text_on_primary</item>
        <item name="backgroundTint">@color/nb_coral_accent</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">52dp</item>
    </style>

    <style name="Widget.NumberBookApp.LookupButton" parent="Widget.Material3.Button">
        <item name="android:textColor">@color/nb_text_on_primary</item>
        <item name="backgroundTint">@color/nb_teal_dark</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">44dp</item>
    </style>
</resources>
